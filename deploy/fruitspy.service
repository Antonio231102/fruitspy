[Unit]
Description=FruitSpy GameSpy-compatible multiplayer service
Documentation=https://github.com/Antonio231102/fruitspy
Wants=network-online.target
After=network-online.target

[Service]
Type=exec
DynamicUser=yes
WorkingDirectory=/opt/fruitspy/server
ExecStart=/opt/fruitspy/venv/bin/python -m fruitspy --config /etc/fruitspy/config.json
ExecStartPost=/opt/fruitspy/venv/bin/python -m fruitspy.healthcheck --config /etc/fruitspy/config.json --host 127.0.0.1 --timeout 1 --wait 15
Restart=on-failure
RestartSec=2s
TimeoutStartSec=30s
TimeoutStopSec=35s
KillSignal=SIGTERM

NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectSystem=strict
RestrictAddressFamilies=AF_INET AF_UNIX
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
UMask=0077

LimitNOFILE=1024
TasksMax=64
MemoryMax=256M

[Install]
WantedBy=multi-user.target
