[Unit]
Description=FruitSpy GameSpy-compatible multiplayer service
Documentation=https://github.com/Antonio231102/fruitspy
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
WorkingDirectory=%h/fruitspy/server
ExecStart=/usr/bin/python3 -m fruitspy --config %h/.config/fruitspy/config.json
ExecStartPost=/usr/bin/python3 -m fruitspy.healthcheck --config %h/.config/fruitspy/config.json --host 127.0.0.1 --timeout 1 --wait 15
Restart=on-failure
RestartSec=2s
TimeoutStartSec=30s
TimeoutStopSec=35s
KillSignal=SIGTERM

NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectSystem=strict
RestrictAddressFamilies=AF_INET AF_UNIX
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
UMask=0077

LimitNOFILE=1024
TasksMax=64
MemoryMax=256M

[Install]
WantedBy=default.target
